<!-- Ayarlar penceresinin renkleri, fırçaları ve yazı tipleri: Windows ayarlarına benzeyen koyu zemin, koyu gri kartlar ve açık mavi vurgu. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Zemin, kart, çerçeve ve yazı renkleri -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="PanelBrush" Color="#272727" />
    <SolidColorBrush x:Key="CardBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="HoverBrush" Color="#353535" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ShellEdgeBrush" Color="#33FFFFFF" />

    <!-- Tehlikeli komutların yazısı ("Ağları temizle" gibi) -->
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF99A4" />

    <!-- Hatırlatmanın zamanının durduğu mavi hap ("Bugün 14:30") -->
    <SolidColorBrush x:Key="AccentTintBrush" Color="#1F60CDFF" />

    <!-- "Ayarlar kaydedilemedi" gibi uyarıların şeridi -->
    <SolidColorBrush x:Key="WarningBackBrush" Color="#433519" />
    <SolidColorBrush x:Key="WarningIconBrush" Color="#FCE100" />

    <!-- Pencerenin üst köşesindeki soluk mavi ışıltı -->
    <RadialGradientBrush x:Key="AuroraBrush" Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.75" RadiusY="0.55">
        <GradientStop Color="#2E60CDFF" Offset="0" />
        <GradientStop Color="#1A7B61FF" Offset="0.45" />
        <GradientStop Color="#00202020" Offset="1" />
    </RadialGradientBrush>

    <!-- Başlıktaki uygulama simgesinin rozeti: maviden mora geçiş -->
    <LinearGradientBrush x:Key="BadgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7DD8FF" Offset="0" />
        <GradientStop Color="#9C8CFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Windows 11'de modern Segoe UI Variable, yoksa Segoe UI kullanılır -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Simgeler Windows'un kendi simge yazı tipinden gelir -->
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>

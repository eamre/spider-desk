<UserControl x:Class="SpiderDesk.Infrastructure.Flyout.Pages.SpiderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sekme pencereye eklenmeden önce kurulduğu için stilleri kendisi yükler -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpiderDesk;component/Infrastructure/Flyout/Styles/DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Seviye kartı: rozet, seviye ve bir sonraki seviyeye kalan av -->
        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource BadgeBrush}" Margin="0,0,16,0">
                    <TextBlock x:Name="LevelBadgeText" Text="1" FontSize="24" FontWeight="SemiBold" Foreground="#0B0B0B"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="LevelText" Text="Seviye 1" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <!-- İlerleme çubuğu: gri iz ve üstünde bu seviyede yakalanan av kadar dolu mavi şerit -->
                    <Grid Height="6" Margin="0,9,0,6">
                        <Border CornerRadius="3" Background="{StaticResource BorderBrush}" />
                        <Border x:Name="LevelFill" CornerRadius="3" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LevelFillScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="NextLevelText" Style="{StaticResource CardDescription}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Üç küçük bilgi kartı -->
        <UniformGrid Columns="3" Margin="0,0,-4,0">
            <Border Style="{StaticResource Card}" Margin="0,0,4,4" Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Tokluk" />
                    <TextBlock x:Name="SatietyText" Style="{StaticResource StatValue}" Text="%0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,4,4" Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Toplam av" />
                    <TextBlock x:Name="BugsText" Style="{StaticResource StatValue}" Text="0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,4,4" Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Şu an" />
                    <TextBlock x:Name="ActivityText" Style="{StaticResource StatValue}" FontSize="13" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Komutlar" />

        <UniformGrid Columns="2" Margin="0,0,-4,0">
            <Button x:Name="NewWebButton" Style="{StaticResource CommandTile}" Click="OnNewWebClicked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE710;" />
                    <TextBlock Text="Yeni ağ ör" />
                </StackPanel>
            </Button>
            <Button x:Name="RappelButton" Style="{StaticResource CommandTile}" Click="OnRappelClicked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE74B;" />
                    <TextBlock Text="Tavandan sark" />
                </StackPanel>
            </Button>
            <Button x:Name="RainButton" Style="{StaticResource CommandTile}" Click="OnRainClicked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CommandIcon}" Text="&#xE753;" />
                    <TextBlock Text="Ağlara çiy bırak" />
                </StackPanel>
            </Button>
            <Button x:Name="SpawnBugsButton" Style="{StaticResource CommandTile}" Click="OnSpawnBugsClicked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CommandIcon}" Text="&#xEBE8;" />
                    <TextBlock x:Name="SpawnBugsText" Text="Böcek gönder" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Geri alınamayan tek komut: kırmızı ve en altta -->
        <Button x:Name="ClearWebsButton" Style="{StaticResource CommandTile}" Foreground="{StaticResource DangerTextBrush}" Margin="0"
                Click="OnClearWebsClicked">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CommandIcon}" Foreground="{StaticResource DangerTextBrush}" Text="&#xE74D;" />
                <TextBlock Text="Ağları temizle" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

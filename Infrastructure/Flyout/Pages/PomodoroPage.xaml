<UserControl x:Class="SpiderDesk.Infrastructure.Flyout.Pages.PomodoroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sekme pencereye eklenmeden önce kurulduğu için stilleri kendisi yükler -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SpiderDesk;component/Infrastructure/Flyout/Styles/DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,24">
            <StackPanel>
                <!-- Geri sayım halkası: gri iz, üstünde kalan süre kadar dolu renkli yay -->
                <Grid Width="200" Height="200" HorizontalAlignment="Center">
                    <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="10" />
                    <Path x:Name="ProgressArc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{StaticResource AccentBrush}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="25:00" FontSize="46" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="StatusText" Text="Hazır" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="150" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource PillPrimaryButton}" Content="Başlat"
                            Click="OnPrimaryClicked" />
                    <Button x:Name="FinishButton" Style="{StaticResource PillSecondaryButton}" Content="Bitir"
                            Margin="8,0,0,0" Visibility="Collapsed" Click="OnFinishClicked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Süre" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Odak ve mola süreleri" />
                <TextBlock x:Name="PresetDescription" Style="{StaticResource CardDescription}" />
                <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <StackPanel x:Name="PresetChoices" Orientation="Horizontal" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

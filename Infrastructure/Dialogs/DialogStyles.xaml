<!-- SpiderDesk pencerelerinin ortak görünümü: krem zemin, kahverengi vurgu. Hatırlatıcı ve ayarlar penceresi bunu kullanır. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentBrush" Color="#6B5B3E" />
    <SolidColorBrush x:Key="SoftBorderBrush" Color="#D9CFBC" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8C8273" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F4EEE2" />
    <SolidColorBrush x:Key="HoverBrush" Color="#ECE4D4" />

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
</ResourceDictionary>

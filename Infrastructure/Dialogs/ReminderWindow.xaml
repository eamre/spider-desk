<Window x:Class="SpiderDesk.Infrastructure.Dialogs.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hatırlatıcı"
        Icon="pack://application:,,,/SpiderDesk;component/spider.ico"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#FFFDF8"
        Foreground="#2F2A24">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/SpiderDesk;component/Infrastructure/Dialogs/DialogStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- Hızlı süre seçenekleri: aynı gruptaki radyo düğmeleri, hap şeklinde düğmeler olarak görünür -->
        <Style x:Key="QuickDelayButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="13" Padding="12,4"
                                Background="White" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="Ne hatırlatayım?" Style="{StaticResource SectionTitle}" />
        <TextBox x:Name="NoteInput" TextChanged="OnInputChanged" />
        <TextBlock x:Name="CharacterCount" HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="11" Foreground="#8C8273" />

        <TextBlock Text="Ne zaman?" Style="{StaticResource SectionTitle}" Margin="0,6,0,8" />
        <!-- Düğmeler ReminderTime.QuickDelays listesinden kodda oluşturulur -->
        <WrapPanel x:Name="QuickDelayPanel" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="ya da saat:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ClockInput" Width="72" ToolTip="Örneğin 14:30" TextChanged="OnClockChanged" />
        </StackPanel>

        <TextBlock x:Name="DuePreview" Margin="0,14,0,0" FontWeight="SemiBold" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="İptal" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Kaydet" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
